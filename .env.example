# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://copilot_user:copilot_password@localhost:5432/job_copilot?schema=public"

# Master secret for AES-256-GCM encryption at rest (profiles, resumes, saved AI API keys).
# STRONGLY recommended: without it the key is derived from DATABASE_URL + GEMINI_API_KEY,
# so changing either of them makes previously encrypted data unreadable.
# Generate one with: openssl rand -hex 32
DATA_ENCRYPTION_KEY="your_32_byte_random_secret_here"

# ---------------------------------------------------------------------------
# AI provider (server default). Every user can override it in the dashboard:
# "Configurações" -> "Provedor de Inteligência Artificial".
# ---------------------------------------------------------------------------
# AI_PROVIDER: gemini | anthropic | openai | openrouter | groq | deepseek | mistral | ollama | lmstudio | custom
# AI_PROVIDER="gemini"
# AI_MODEL="gemini-3.8-flash"
# AI_API_KEY=""            # or the provider-specific variable below
# AI_BASE_URL=""           # only for custom / self-hosted OpenAI-compatible endpoints

# Provider-specific keys (used when AI_API_KEY is empty)
GEMINI_API_KEY="your_gemini_api_key_here"
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
# OPENROUTER_API_KEY=""
# GROQ_API_KEY=""
# DEEPSEEK_API_KEY=""
# MISTRAL_API_KEY=""

# Examples:
#   Claude:  AI_PROVIDER="anthropic"  AI_MODEL="claude-opus-5-5"  ANTHROPIC_API_KEY="..."
#   Ollama:  AI_PROVIDER="ollama"     AI_MODEL="llama3.1"         (no key, runs locally)

# CLI evaluator only (npm run evaluate) — the dashboard uses "Configurações" instead
# EVALUATION_CRITERIA="Only remote jobs, except in Cascavel/PR where on-site is fine."
# EVALUATION_MIN_SCORE="80"
# EVALUATION_REQUIRED_KEYWORDS="remote,remoto,cascavel"
