{
  "manifest_version": 3,
  "name": "Job Copilot Auto-Filler",
  "version": "1.0",
  "description": "Fills out job application forms using data from your Job Copilot database.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}

