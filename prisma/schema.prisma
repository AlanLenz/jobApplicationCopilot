generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Job {
  id                  String   @id @default(uuid())
  title               String
  company             String?
  url                 String   @unique
  description         String
  requirements        String?
  status              String   @default("pending_evaluation") // pending_evaluation, approved, rejected, applied
  matchScore          Int?
  matchReason         String?
  customCoverLetter   String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

